PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use the public browser key from Supabase Project Settings > API Keys.
# New Supabase projects usually show this as a publishable key:
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
#
# Older projects may show a legacy anon key instead:
PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-key
